# Log-Analyzer / Logatory config example — copy to config.yaml and adapt

pii_salt: ""           # set here or via LOGATORY_PII_SALT env var
db_path: logatory.db  # use /data/logatory.db inside Docker
pii_rules_path: pii_rules.yaml

# REST API auth — leave empty to disable (local dev / Docker with firewall)
# Set via env var LOGATORY_API_TOKEN or here (prefer env var)
api_token: ""

# Plugin directory — *.py files here are auto-loaded at startup
# plugins_dir: plugins/

# Finding retention and minimum severity for --track-errors persistence
# findings_retention_days: 30
# findings_min_severity: high

# Alert channels — findings at/above each channel's min_severity are pushed.
# Applies to every realtime command (tail, docker tail, fleet tail, …).
# Types: slack | discord | webhook | email.  ${ENV_VAR} is expanded, so keep
# secrets in the environment. Verify with: logatory alerts test
# Optional 'cooldown' (seconds) throttles repeats of the same finding
# (rule_id + source) per channel — 0 (default) delivers every match.
# Optional escalation ('escalate_count' + 'escalate_window' seconds) only fires
# after the same finding occurs N times within the window — good for noisy rules.
# alerts:
#   - type: slack
#     url: ${SLACK_WEBHOOK_URL}
#     min_severity: high
#     cooldown: 300        # at most one alert per rule+source every 5 min
#   - type: webhook
#     url: https://hooks.example.com/security
#     min_severity: medium
#     escalate_count: 5     # only alert once the same finding
#     escalate_window: 120  # fires 5 times within 120 seconds
#   - type: email
#     min_severity: critical
#     smtp_host: smtp.example.com
#     smtp_port: 587
#     smtp_user: alerts@example.com
#     smtp_password: ${SMTP_PASSWORD}
#     use_tls: true
#     sender: alerts@example.com
#     recipients:
#       - oncall@example.com

llm:
  provider: ollama
  model: gemma3:4b
  endpoint: http://localhost:11434
  temperature: 0.1
  max_context_tokens: 8000

opensearch:
  host: localhost
  port: 9200
  use_ssl: false
  verify_certs: true

  # Auth — prefer env vars over plain-text credentials in this file:
  #   OPENSEARCH_USERNAME / OPENSEARCH_PASSWORD
  #   OPENSEARCH_API_KEY
  #   OPENSEARCH_CLIENT_CERT / OPENSEARCH_CLIENT_KEY / OPENSEARCH_CA_CERTS
  #
  # username: myuser
  # password: secret
  # api_key: "keyid:base64encodedkey"
  # ca_certs: /etc/ssl/certs/my-ca.pem
  # client_cert: /etc/ssl/certs/client.pem
  # client_key: /etc/ssl/private/client.key

  # Index and field mapping defaults
  default_index: "logstash-*"
  timestamp_field: "@timestamp"
  message_field: "message"
  severity_field: "level"
  source_name_field: "host.name"
